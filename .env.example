# --- required for the web app ---
ASSEMBLYAI_API_KEY=            # Voice Agent API + async transcription
GEMINI_API_KEY=                # embeddings for the semantic lookback
HARK_AGENT_ID=             # printed by scripts/create_agent.py

# Which voice engine the page starts on: "assemblyai" (the cloud Voice Agent,
# one websocket, needs the key above) or "local" (Whistle + Needle + PocketTTS
# on this machine). The page has a toggle either way; this is only the default.
# "local" runs only where this server does -- it cannot work on Vercel. The
# answer text still comes from Gemini, so GEMINI_API_KEY is needed for both.
HARK_VOICE_PROVIDER=assemblyai

# --- optional: local-mode tuning ---
# Which model writes the spoken answer in local mode: "gemini" (cloud, default)
# or "gemma" (Google's Gemma on a local llama.cpp server, or anything
# OpenAI-compatible; "qwen" is still accepted as an alias). The page
# has a toggle either way; this is the default it starts from.
# HARK_LOCAL_LLM=gemini
# The model Gemini uses. Unset uses hark/core/brain.CHAT_MODEL. A lighter one
# answers faster; the retrieved passage is short, so quality mostly holds.
# HARK_LOCAL_CHAT_MODEL=gemini-flash-lite-latest
# Where the Gemma backend is served. Start one with scripts/start_local_llm.ps1
# (llama.cpp, models/gemma-3-1b-it-Q4_K_M.gguf, port 8081).
# HARK_LOCAL_LLM_BASE_URL=http://127.0.0.1:8081/v1
# HARK_LOCAL_LLM_MODEL=gemma-3-1b-it
# HARK_LOCAL_LLM_API_KEY=
# int8-quantise PocketTTS: faster and smaller on CPU. Set to 0 to disable.
# HARK_TTS_QUANTIZE=1
# Speech capture. Silence before a turn is considered finished, in ms -- lower
# answers sooner but can cut a thinking pause in half. Live partials show words
# as you speak; set to 0 to only show the final transcript.
# HARK_STT_SILENCE_MS=450
# HARK_STT_PARTIALS=1
# Silero VAD decides what is speech, so noise neither opens a turn nor reaches
# speech-to-text. Set to 0 to gate on loudness alone.
# HARK_STT_VAD=1

# The built-in titles, in shelf order; the first is the default. Each needs an
# index in data/<id>.db (or media/<id>.db for local-only titles); data/catalog.json
# gives each its title, author, kind, topic and blurb. HARK_BOOK (one id) also works.
HARK_BOOKS=calculus,nasa-dark-side,einstein-relativity,russell-appearance

# --- ceilings, as settings rather than constants ---
# A direct upload, in MB. Only ours down to whatever the host enforces first:
# Vercel rejects a request body over ~4.5 MB at the edge, before this code
# runs, so raising this past that only helps somewhere without that cap.
HARK_MAX_UPLOAD_MB=4
# A book fetched from a link. No platform ceiling applies here, which is why
# links are the path for a full-length book.
HARK_MAX_SOURCE_MB=150

# --- shared state ---
# The browser reports the playhead to one request and AssemblyAI's tool call
# arrives on another, so the two need somewhere shared to meet. Without these
# the server falls back to process memory, which is fine locally and wrong on
# serverless (every invocation is a different process).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- optional: only for the retired desktop client (run_demo.py, mic_check.py) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Shown as the built-in book name. Defaults to the Calculus chapter shipped
# in data/ and public/audio/.
HARK_BOOK_TITLE=Calculus Made Easy, ch. 3
